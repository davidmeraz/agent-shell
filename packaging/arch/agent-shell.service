[Unit]
Description=Agent Shell (Aplicación nativa Qt6/Wayland + harness local de IA)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/agent-shell
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
