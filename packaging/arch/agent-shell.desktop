[Desktop Entry]
Type=Application
Version=1.0
Name=Agent Shell
GenericName=AI Coding Shell
Comment=Aplicación nativa Qt6/Wayland de IA con ejecución local de shell y proyectos Work integrada con Hyprland y Gema
Exec=/usr/bin/agent-shell
Icon=agent-shell
Terminal=false
Categories=Development;
Keywords=ai;chatgpt;claude;gemini;shell;terminal;coding;hyprland;gema;
StartupNotify=false
StartupWMClass=agent-shell
Actions=toggle;quit;

[Desktop Action toggle]
Name=Mostrar / Ocultar Agent Shell
Exec=/usr/bin/agent-shell --toggle

[Desktop Action quit]
Name=Cerrar Agent Shell
Exec=/usr/bin/agent-shell --quit
