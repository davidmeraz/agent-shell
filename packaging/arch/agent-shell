#!/usr/bin/env bash
# Lanzador del sistema para Agent Shell en Arch Linux.
set -euo pipefail

APP_DIR="${AGENT_SHELL_APP_DIR:-/usr/share/agent-shell}"
export AGENT_SHELL_PYTHON="${AGENT_SHELL_PYTHON:-/usr/bin/python3}"
export AGENT_SHELL_BACKEND_ENTRY="${AGENT_SHELL_BACKEND_ENTRY:-$APP_DIR/backend/main.py}"

if [[ -z "${AGENT_SHELL_WORKSPACE:-}" ]]; then
    if [[ "$PWD" == "/" || "$PWD" == /usr/* ]]; then
        export AGENT_SHELL_WORKSPACE="$HOME"
    else
        export AGENT_SHELL_WORKSPACE="$PWD"
    fi
fi

exec qs --no-duplicate --path "$APP_DIR/shell.qml" "$@"
